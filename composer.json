{
  "name": "mbpcoder/jarchi",
  "description": "Send service notification to bots",
  "keywords": [
    "notification",
    "telegram bot"
  ],
  "authors": [
    {
      "name": "Mahdi Bagheri",
      "email": "mb.programmer@yahoo.com",
      "homepage": "https://www.linkedin.com/in/mahdibagheri"
    }
  ],
  "require": {
    "php": "^8.5",
    "ext-mbstring": "*",
    "vlucas/phpdotenv": "^5.5",
    "ext-curl": "*",
    "guzzlehttp/guzzle": "^7.0",
    "monolog/monolog": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/hepers.php"
    ]
  },
  "require-dev": {
    "rector/rector": "^2.4",
    "phpunit/phpunit": "^13.1"
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  }
}
