{
    "name": "mbpcoder/jarchi",
    "description": "Send service notification to bots",
    "keywords": [
        "notification",
        "telegram bot"
    ],
    "authors": [
        {
            "name": "Mahdi Bagheri",
            "email": "mb.programmer@yahoo.com",
            "homepage": "https://www.linkedin.com/in/mahdibagheri"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "laravel/framework": "^13.0",
        "guzzlehttp/guzzle": "^7.0",
        "monolog/monolog": "^3.10",
        "laravel-notification-channels/telegram": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/hepers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "rector/rector": "^2.4",
        "phpunit/phpunit": "^13.1",
        "laravel/pail": "^1.2",
        "laravel/tinker": "^3.0",
        "nunomaduro/collision": "^8.9"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    }
}
